#!/bin/sh

__is_jail_uuid () {
    printf '%s\n' "$1" | grep -Eq \
        '^[[:xdigit:]]{8}(-[[:xdigit:]]{4}){3}-[[:xdigit:]]{12}$'
}

__is_template_tag () {
    printf '%s\n' "$1" | grep -Eq '^[[:alnum:]_][[:alnum:]_.:-]*$'
}

# Export every property specified on command line ----------------------
__export_props () {
    local _pname _property
    for _property in "$@" ; do
        case "${_property}" in
            *=*)
                _pname="${_property%%=*}"
                __validate_pname "${_pname}" ""
                export "${_property}"
                export "iocset_${_property}"
                ;;
        esac
    done
    if [ "${tag:-}" = default ] && [ "${1:-}" != set ] &&
        [ "${1:-}" != get ] ; then
        tag=$(date "+%F@%T")
        echo "  WARNING: tag value \"default\" is a reserved keyword" >&2
        echo "           tag was changed to: $tag" >&2
    fi
}

# Defaults are configuration, never a jail or a parent ZFS dataset.
__default_property_allowed () {
    case "$1" in
        pool|tag|host_hostname|host_hostuuid|hostid|last_started|\
        jail_zfs_dataset|istemplate|template|\
        origin|mountpoint|compressratio|available|used) return 1 ;;
    esac
    return 0
}

__set_default_prop () {
    local _property _pname _pval _tmp _status

    _property="$1"
    case "${_property}" in
        *=*) _pname="${_property%%=*}"; _pval="${_property#*=}" ;;
        *) __error "set failed, incorrect property syntax!"; return 1 ;;
    esac
    if [ -z "${_pname}" ] || [ -z "${_pval}" ] ; then
        __error "set failed, incorrect property syntax!"
        return 1
    fi
    __validate_pname "${_pname}" ""
    if ! __default_property_allowed "${_pname}" ; then
        __error "${_pname} is managed or read-only; not a creation default"
        return 1
    fi
    case "${_pname}" in
        vnet|bpf|dhcp|boot|jail_zfs|rlimits|createbridge|keepbridge)
            case "${_pval}" in
                on|off) ;;
                *) __error "${_pname} must be on or off"; return 1 ;;
            esac
            ;;
    esac
    case "${iocroot}" in
        /*) ;;
        *) __error "invalid defaults directory"; return 1 ;;
    esac
    if [ "${iocroot}" = / ] || [ ! -f "${iocroot}/.default" ] ; then
        __error "missing or invalid defaults configuration"
        return 1
    fi

    # Prepare a separate file; parse/write failures must retain the original.
    _tmp=$(mktemp "${iocroot}/.default.XXXXXX") || return $?
    if cp -p "${iocroot}/.default" "${_tmp}" &&
        uclcmd set -u -f "${_tmp}" -t string -- "${_pname}" "${_pval}" &&
        mv -f "${_tmp}" "${iocroot}/.default" ; then
        return 0
    else
        _status=$?
        rm -f "${_tmp}"
        return "${_status}"
    fi
}

# Load before explicit create arguments, not during reads or existing-jail edits.
__load_create_defaults () {
    local _prop _value _raw

    for _prop in ${CONF_NET} ${CONF_JAIL} ${CONF_RCTL} ${CONF_CUSTOM} \
        ${CONF_SYNC} ${CONF_FTP} ${CONF_GIT} ${CONF_ZFS} ; do
        __default_property_allowed "${_prop}" || continue
        _value=$(uclcmd get -qf "${iocroot}/.default" "${_prop}") || return $?
        if [ "${_value}" = null ] ; then
            # A literal string "null" is not a missing UCL property.
            _raw=$(uclcmd get -f "${iocroot}/.default" "${_prop}") || return $?
            [ "${_raw}" != null ] || continue
        fi
        export "${_prop}=${_value}"
    done
}

# Set properties ------------------------------------------------------
__set_jail_prop () {
    local _name _property _dataset _pname _pval _found _CONF \
          _type _state _tag _jail_type _jail_zfs_mountpoint \
          _jail_zfs_datasets _old_mountpoint _tmp_mountpoint _zfs_dataset \
          _jid _jailed_dataset _jailed_dataset_check \
          _jail_zfs _newuuid _template_tag _jailed_state _status _fs

    _name="$2"
    _property="$1"

    if [ -z "${_name}" -o -z "${_property}" ] ; then
        __die "missing property or UUID!"
    fi

    case "${_property}" in
        *=*) ;;
        *) __error "set failed, incorrect property syntax!"; return 1 ;;
    esac
    if [ "${_name}" = default ] ; then
        __set_default_prop "${_property}"
        return $?
    fi

    if [ "$3" ] ; then
        _dataset="$3"
    else
        _dataset="$(__find_jail ${_name})" || exit $?
    fi

    _fulluuid="$(__check_name ${_name} ${_dataset})"

    _pname="${_property%%=*}"
    _pval="${_property#*=}"
    _jail_type="$(__get_jail_prop type ${_fulluuid} ${_dataset})"

    if [ -z "${_pname}" -o -z "${_pval}" ] ; then
        __die "set failed, incorrect property syntax!"
    fi

    _type="$(__validate_pname ${_pname} type)" || exit $?

    case "${_pname}" in
        tag)
            __link_tag "${_dataset}" "${_pval}" update || return $?
            __unlink_tag "${_dataset}" "" "${_pval}"
            return $?
            ;;
        jail_zfs)
            if [ "${jail_zfs}" = "on" ] ; then
                __setup_jail_zfs_datasets "${_fulluuid}" "${_dataset}"

            elif [ "${jail_zfs}" != "off" ] ; then
                __die "The setting for jail_zfs must be either 'on' or 'off'."
            fi

            ;;
        jail_zfs_dataset)
            _jail_zfs="$(__get_jail_prop jail_zfs "${_fulluuid}" "${_dataset}")"

            # Do not create ZFS datasets for a jail unless jail_zfs is on.
            # If it is currently "off", the datasets will be created when
            # it is changed to "on".
            if [ "${_jail_zfs}" = "on" ] ; then
                _state="$(__is_running ${_fulluuid})"
                if [ ! -z "${_state}" ] ; then
                    __die "cannot change ZFS datasets while jail is running!"
                fi

                __setup_jail_zfs_datasets "${_fulluuid}" "${_dataset}" \
                    "${jail_zfs_dataset}"
            fi

            ;;
        bpf)
            # Do they want bpf exposed?
            if [ "${_devfs_string}" != "0" ] ; then
                __bpf_devfs >> /etc/devfs.rules
                service devfs restart 1> /dev/null
            fi
            ;;
        jail_zfs_mountpoint)
            _state="$(__is_running ${_fulluuid})"
            _jail_zfs="$(__get_jail_prop jail_zfs "${_fulluuid}" "${_dataset}")"
            _jail_zfs_datasets="$(__get_jail_prop jail_zfs_dataset \
                "${_fulluuid}" "${_dataset}")"

            # Enforce the rule that jail_zfs_mountpoint must be "none" when
            # the jail has multiple datasets assigned.
            if [ "$(echo "${_jail_zfs_datasets}" | grep '[ 	]')" ] ; then
                if [ "${jail_zfs_mountpoint}" != "none" ] ; then
                    # Do not __die here, as this may be called from
                    # __create_jail, and that could leave the jail incompletely
                    # configured.  Instead, just force the value to "none" and
                    # carry on.
                    __info "With multiple ZFS datasets per jail," \
                          "jail_zfs_mountpoint must be set to 'none'."
                    jail_zfs_mountpoint="none"
                fi
            fi

            _old_mountpoint="$(__get_jail_prop jail_zfs_mountpoint \
                "${_fulluuid}" "${_dataset}")"

            # Nothing to do for the dataset mountpoint properties if:
            # - jail_zfs isn't "on"
            # or
            # - the value isn't changing
            # or
            # - the new value is "none".  We don't make changes when the new
            # value is "none" because "none" is how we say "you have to manage
            # it directly using 'zfs set'".
            if [ "${jail_zfs}" = "on" -a "${jail_zfs_mountpoint}" != "none" -a \
                 "${_old_mountpoint}" != "${jail_zfs_mountpoint}" ] ; then

                if [ ! -z "${_state}" ] ; then
                    __die " jail is running! please stop it before changing " \
                        "mountpoints."
                fi

                for _zfs_dataset in ${_jail_zfs_datasets} ; do

                    _zfs_dataset=$(__zfs_dataset_add_poolname \
                        "${_zfs_dataset}")

                    # If the current value of the dataset's mountpoint prop
                    # doesn't match the old jail_zfs_mountpoint value, assume
                    # that the dataset's mountpoint property has been
                    # manipulated directly and don't change it.
                    _tmp_mountpoint="$(zfs get -Ho value mountpoint \
                        "${_zfs_dataset}")"

                    if [ "${_tmp_mountpoint}" = "${_old_mountpoint}" ] ; then
                        zfs set jailed=off "${_zfs_dataset}"
                        zfs set mountpoint="${jail_zfs_mountpoint}" \
                            "${_zfs_dataset}"
                        zfs set jailed=on "${_zfs_dataset}"
                    fi

                done
            fi
            ;;
        istemplate)
            if [ "${_jail_type}" != "basejail" -a "${_jail_type}" != "template" ] ; then
                __error "templates aren't supported for this jail type (${_jail_type})"
                return 1
            fi

            if [ "${_pval}" = "yes" ] ; then
                _tag=$(__get_jail_prop tag "${_fulluuid}" "${_dataset}") || return $?
                _state="$(__is_running ${_fulluuid})"
                if [ -n "${_state}" ] ; then
                    __error "cannot make ${_tag} a template - jail is running!"
                    return 1
                fi
                if ! __is_template_tag "${_tag}" ; then
                    __error "tag is not a safe template dataset name; retag first"
                    return 1
                fi
                if [ "${_dataset}" != \
                    "${pool}/iocell/jails/${_fulluuid}" ] ; then
                    __error "${_tag} is already a template"
                    return 1
                fi
                if zfs get -H creation "${pool}/iocell/templates/${_tag}" \
                    >/dev/null 2>&1 ; then
                    __error "template destination already exists: ${_tag}"
                    return 1
                fi
                _old_mountpoint="$(__get_jail_prop mountpoint \
                    "${_fulluuid}" "${_dataset}")" || return $?
                __check_children "${_fulluuid}" "${_dataset}" || return $?

                _jailed_dataset="${_dataset}/data"
                _jailed_dataset_check="$(zfs get -H creation \
                    "${_jailed_dataset}" >/dev/null 2>&1; echo $?)"
                _jailed_state=off
                if [ "${_jailed_dataset_check}" = 0 ] ; then
                    _jailed_state=$(zfs get -H -o value jailed \
                        "${_jailed_dataset}") || return $?
                    if [ "${_jailed_state}" = on ] ; then
                        zfs set jailed=off "${_jailed_dataset}" || return $?
                    fi
                fi
                __info "converting ${_tag} to a template"
                zfs rename -f "${_dataset}" \
                    "${pool}/iocell/templates/${_tag}" || {
                        _status=$?
                        if [ "${_jailed_state}" = on ] ; then
                            zfs set jailed=on "${_jailed_dataset}" || \
                                __error "failed restoring ${_jailed_dataset}"
                        fi
                        return "${_status}"
                    }
                _dataset="${pool}/iocell/templates/${_tag}"
                if [ "${_jailed_state}" = on ] ; then
                    zfs set jailed=on "${_dataset}/data" || return $?
                fi
                # No metadata or alias changes until the rename succeeds.
                __set_jail_prop type=template "${_fulluuid}" "${_dataset}" \
                    || return $?
                __unlink_tag "${_dataset}" "${_old_mountpoint}"
            elif [ "${_pval}" = "no" ] ; then
                _template_tag=$(__get_jail_prop tag "${_fulluuid}" "${_dataset}") || return $?
                if [ "${_dataset}" != "${pool}/iocell/templates/${_template_tag}" ] ; then
                    __error "${_template_tag} is already a jail"
                    return 1
                fi
                _newuuid="$(__get_jail_prop host_hostuuid \
                    "${_fulluuid}" "${_dataset}")" || return $?

                # Template datasets are named by tag, not by jail UUID.
                if ! __is_jail_uuid "${_newuuid}" ; then
                    __error "invalid stored jail UUID: ${_newuuid}"
                    return 1
                fi

                if [ -n "$(__is_running "${_newuuid}")" ] || \
                    [ -n "$(__is_running "${_fulluuid}")" ] ; then
                    __error "please stop ${_template_tag} before converting it!"
                    return 1
                fi

                if [ ! -d "${iocroot}/templates/${_template_tag}" ] ; then
                    __error "${_template_tag} is already a jail"
                    return 1
                fi

                _jailed_dataset="${_dataset}/data"
                _jailed_dataset_check="$(zfs get -H creation ${_jailed_dataset} > \
                                       /dev/null 2>&1 ; echo $?)"

                __check_children "${_fulluuid}" "${_dataset}" || return $?

                _jailed_state=off

                if [ "${_jailed_dataset_check}" = "0" ] ; then
                    _jailed_state="$(zfs get -H -o value jailed \
                        "${_jailed_dataset}")" || return $?

                    if [ "${_jailed_state}" = "on" ] ; then
                        zfs set jailed=off "${_jailed_dataset}" || return $?
                    fi
                fi

                __info "converting ${_template_tag} to a jail"
                zfs rename -f "${_dataset}" \
                    "${pool}/iocell/jails/${_newuuid}" || {
                        _status=$?

                        if [ "${_jailed_state}" = "on" ] ; then
                            zfs set jailed=on "${_jailed_dataset}" || \
                                __error "failed restoring ${_jailed_dataset}"
                        fi

                        return "${_status}"
                    }

                # Only update metadata and links after a successful rename.
                _dataset="${pool}/iocell/jails/${_newuuid}"
                _fulluuid="${_newuuid}"
                _jailed_dataset="${_dataset}/data"

                if [ "${_jailed_state}" = "on" ] ; then
                    zfs set jailed=on "${_jailed_dataset}" || return $?
                fi

                __set_jail_prop type="basejail" "${_newuuid}" "${_dataset}" \
                    || return $?
                __link_tag "${_dataset}" "${_template_tag}" || return $?
                __check_basejail "${_newuuid}" "${_dataset}" \
                    > /dev/null || return $?
                __umount_basejail "${_newuuid}" "${_dataset}" \
                    > /dev/null 2>&1
            fi
            ;;
        allow*)
            # get jid for iocell jails
            _jid=$(jls -j ioc-${_fulluuid} jid 2> /dev/null)

            if [ ! -z "${_jid}" ] ; then
                # These actually still want one _ instead of all periods.
                if [ "${_pname}" = "allow_raw_sockets" \
                    -o "${_pname}" = "allow_socket_af" \
                    -o "${_pname}" = "allow_set_hostname" ] ; then
                    _jail_pname="$(echo ${_pname} | sed 's/_/./')"
                else
                    _jail_pname="$(echo ${_pname} | sed 's/_/./g')"
                fi

                jail -m "jid=${_jid}" "${_jail_pname}=${_pval}"
            fi
            ;;
        template)
            if [ "${_pval}" = "yes" ] ; then
                __die "please set istemplate=yes instead."
            elif [ "${_pval}" = "no" ] ; then
                __die "please set istemplate=no instead."
            fi
            ;;
        hack88)
            _state="$(__is_running ${_fulluuid})"

            if [ ! -z "${_state}" ] ; then
                __die " jail is running! please stop it before changing hack88."
            fi
            ;;
        host_hostname)
            _state="$(__is_running ${_fulluuid})"

            if [ ! -z "${_state}" ] ; then
                __info " jail is running! you may need to restart the jail"\
                "to see the changes."
            fi

            cat ${iocroot}/jails/${_fulluuid}/root/etc/rc.conf | \
                sed -E "s/hostname.*/hostname=\"${host_hostname}\"/g" \
                > ${iocroot}/jails/${_fulluuid}/rc.conf
            mv ${iocroot}/jails/${_fulluuid}/rc.conf \
               ${iocroot}/jails/${_fulluuid}/root/etc/rc.conf
            ;;
    esac

    if [ "${_type}" = "custom" ] ; then
        _mountpoint="$(__get_jail_prop mountpoint \
            "${_fulluuid}" "${_dataset}")" || return $?
        __ucl_set "${_mountpoint}" "${_pname}" "${_pval}" || return $?
    elif [ "${_type}" = "native" ] ; then
        zfs set ${_pname}="${_pval}" ${_dataset}
    fi
}

__validate_pname () {
    local _prop _pname _found

    _pname="$1"
    _type="$2"
    _found=0

    _CONF="$CONF_NET
           $CONF_JAIL
           $CONF_RCTL
           $CONF_CUSTOM
           $CONF_SYNC
           $CONF_FTP
           $CONF_GIT"

    for _prop in ${_CONF} ; do
        if [ "${_prop}" = "${_pname}" ] ; then
            _found=1
            if [ "${_type}" ] ; then
                echo "custom"
            fi
            break
        fi
    done

    for _prop in ${CONF_ZFS} ; do
        if [ "${_prop}" = "${_pname}" ] ; then
            _found=1
            if [ "${_type}" ] ; then
                echo "native"
            fi
            break
        fi
    done

    if [ ${_found} -ne "1" ] ; then
        __die "unsupported property: ${_pname}!"
    fi
}

__console () {
    local _name _dataset _fulluuid _login_flags _jexec _exec_fib \
          _state

    _name=$1

    if [ -z ${_name} ] ; then
        __die "missing UUID!"
    fi

    _dataset=$(__find_jail ${_name}) || exit $?

    if [ -z ${_dataset} ] ; then
        __die "${_name} not found!"
    fi

    _fulluuid="$(__check_name ${_name} ${_dataset})"
    _state=$(__is_running ${_fulluuid})
    _login_flags=$(__get_jail_prop login_flags ${_fulluuid} ${_dataset})
    _exec_fib=$(__get_jail_prop exec_fib ${_fulluuid} ${_dataset})
    _jexec="jexec"

    if [ ${_exec_fib} -ne "0" ] ; then
        _jexec="setfib ${_exec_fib} jexec"
    fi

    if [ "${_state}" ] ; then
        ${_jexec} ioc-${_fulluuid} login ${_login_flags}
    elif [ "${_force}" = "1" ] ; then
        case "${_dataset}" in "${pool}/iocell/templates/"*)
            __error 'cannot start a template through console'; return 1 ;;
        esac
        if [ "$(__get_jail_prop istemplate "${_fulluuid}" "${_dataset}")" = yes ]; then
            __error 'cannot start a template through console'; return 1
        fi
        __start_jail "${_fulluuid}" || return $?
        ${_jexec} ioc-${_fulluuid} login ${_login_flags}
    else
        __die "jail: ${_name} is not running!"
    fi
}

__exec () {
    local _jexecopts _name _dataset _fulluuid _jexec _exec_fib
    _jexecopts=

    # check for -U or -u to pass to jexec
    while getopts u:U: opt "$@"; do
        case "${opt}" in
            [uU]) _jexecopts="${_jexecopts} -${opt} ${OPTARG}";;
            ?)    __die "invalid exec option: ${opt}"
                  ;;
        esac
    done
    shift $(expr ${OPTIND} - 1)

    _name=$1
    shift

    if [ -z "${_name}" ] ; then
        __die "missing UUID!"
    elif [ "${_name}" = "ALL" ]; then
        local _jails _fulluuid
        _jails="$(__find_jail ALL | \
                awk 'BEGIN { FS = "/" } ; { if (length($NF)==36) { print }}')"

        for _jail in ${_jails} ; do
            # _jail is actually a dataset, so fulluuid needs to be faked.
            _fulluuid=$(__check_name "name" ${_jail} 2> /dev/null)
            jexec ${_jexecopts} ioc-${_fulluuid} "$@"
        done

        exit 0
    fi

    _dataset=$(__find_jail ${_name}) || exit $?

    _fulluuid="$(__check_name ${_name} ${_dataset})"

    _exec_fib=$(__get_jail_prop exec_fib ${_fulluuid} ${_dataset})

    _jexec="jexec"
    if [ "${_exec_fib}" -ne "0" ] ; then
        _jexec="setfib ${_exec_fib} jexec"
    fi

    ${_jexec} ${_jexecopts} ioc-${_fulluuid} "$@"
}

# Cleanup release directories
__cleanup_release_dir () {
    local _rel_exist _rel_dir_exist _dwn_rel_exist _dwn_dir_exist _rel_name

    if [ -n "$1" ] ; then
        _rel_name="$1"
    else
        __die "Failed cleanup of RELEASE directories. No RELEASE name defined" >&2
    fi

    _rel_exist=$(zfs get -H -o value name ${pool}/iocell/releases/${_rel_name})
    _dwn_rel_exist=$(zfs get -H -o value name \
        ${pool}/iocell/download/${_rel_name})

    if [ -n "${_rel_exist}" ] ; then
        _rel_dir_exist=$(zfs get -H -o value mountpoint \
            ${pool}/iocell/releases/${_rel_name})
        zfs destroy -fr -- ${pool}/iocell/releases/${_rel_name}
        if [ -d "${_rel_dir_exist}" ]; then
            rm -rf -- ${_rel_dir_exist}
        fi
    fi

    if [ -n "${_dwn_rel_exist}" ] ; then
        _dwn_dir_exist=$(zfs get -H -o value mountpoint \
            ${pool}/iocell/download/${_rel_name})
        zfs destroy -fr -- ${pool}${iocroot}/download/${_rel_name}
        if [ -d "${_dwn_dir_exist}" ]; then
            rm -rf -- ${_dwn_dir_exist}
        fi
    fi
}

# Fetch release and prepare base ZFS filesystems-----------
__fetch_release () {
    local _rel_exist _release _host_release _non_interactive _dist _ports \
          _ports_string _grepmatch

    _release=$(uname -r|cut -f 1,2 -d'-')
    # Needed to check for PC-BSD import
    _host_release=$(uname -r|cut -f 1,2 -d'-')
    _grepmatch='STABLE$|PRERELEASE$|CURRENT$|BETA$'

    for _args in "$@" ; do
        case "${_args}" in
            -P|-p) _ports=1
                ;;
        esac
    done

    if [ -z "${iocset_release}" ] ; then
        __print_release
        echo -n "Please select a release [${_release}]: "
        read _answer

        if [ -z "${_answer}" ] ; then
            _answer="${_release}"
        else
            _release="${_answer}"
            for _rel in $(echo ${supported}) ; do
                if [ "${_answer}" == "${_rel}" ] ; then
                    _release="${_rel}"
                    match="1"
                    break
                fi
            done

            if [ -z ${match} ] ; then
                echo "Invalid release ${_release} specified, exiting.." >&2
                exit 1
            fi
        fi
    else
        _release="${iocset_release}"
    fi



    _rel_exist=$(zfs list -H | grep -w ^${pool}/iocell/releases/${_release})

    if [ -z "${_rel_exist}" ] ; then
        zfs create -o compression=${compression} -p ${pool}/iocell/releases/${_release}/root
        zfs create -o compression=${compression} -p ${pool}/iocell/download/${_release}
    fi

    if [ -z "${ftpdir}" ] ; then
        # Everything but RELEASE is stored here
        if [ "$(echo ${_release} | egrep ${_grepmatch})" ] ; then
            ftpdir="/pub/FreeBSD/snapshots/amd64/${_release}"
        else
            ftpdir="/pub/FreeBSD/releases/amd64/${_release}"
        fi
    fi

    if [ -e "/usr/local/tmp/iocell-dist" -a "${_release}" = "${_host_release}" ] ; then
        cd "/usr/local/tmp/iocell-dist"
        _dist=1
    else
        cd ${iocroot}/download/${_release}
        _dist=0
    fi

    # If $ftplocaldir is set fetch from a local dir else fetch from remote
    # If fetch fails for remote or local remove new directories
    for file in $ftpfiles ; do
        if [ ! -e "$file" ] ; then
            if [ -n "$ftplocaldir" ] ; then
                fetch file://${ftplocaldir}/${file}
                if [ $? -ne 0 ] ; then
                    echo "Failed fetching local $file.." >&2
                    __cleanup_release_dir ${_release}
                    return 1
                fi
            else
                fetch http://${ftphost}${ftpdir}/${file}
                if [ $? -ne 0 ] ; then
                    echo "Failed fetching remote $file.." >&2
                    __cleanup_release_dir ${_release}
                    return 1
                fi
            fi
        fi
    done

    for _file in $(echo ${ftpfiles}) ; do
        if [ -e "${_file}" ] ; then
            echo "Extracting: ${_file}"
            chflags -R noschg ${iocroot}/releases/${_release}/root
            tar -C ${iocroot}/releases/${_release}/root -xf ${_file}
        fi
    done

    # Create these dirs for basejails
    if [ ! -e ${iocroot}/releases/${_release}/root/usr/home ] ; then
        mkdir ${iocroot}/releases/${_release}/root/usr/home > /dev/null 2>&1
        cd ${iocroot}/releases/${_release}/root && ln -s usr/home home 2>&1
    fi

    mkdir ${iocroot}/releases/${_release}/root/compat > /dev/null 2>&1
    mkdir ${iocroot}/releases/${_release}/root/usr/ports > /dev/null 2>&1

    # mount devfs for chroot
    mount -t devfs devfs ${iocroot}/releases/${_release}/root/dev

    cat /etc/resolv.conf > \
            ${iocroot}/releases/${_release}/root/etc/resolv.conf

    if [ ! "$(echo ${_release} | grep -E ${_grepmatch})" ] ; then

        echo "* Updating base jail template."
        sleep 2


        if [ -e ${iocroot}/releases/${_release}/root/etc/freebsd-update.conf ] \
            && [ -z "$ftplocaldir" ] ; then

            case "${_release}" in
                9.3-RELEASE | 10.1-RELEASE)
                    # Remove the interactive check in freebsd-update
                    sed 's/\[ ! -t 0 \]/false/' \
                        ${iocroot}/releases/${_release}/root/usr/sbin/freebsd-update \
                        > ${iocroot}/releases/${_release}/root/tmp/freebsd-update
                    chmod +x ${iocroot}/releases/${_release}/root/tmp/freebsd-update
                    chroot ${iocroot}/releases/${_release}/root \
                        env UNAME_r="${_release}" env PAGER="/bin/cat" \
                        /tmp/freebsd-update fetch
                    rm ${iocroot}/releases/${_release}/root/tmp/freebsd-update
                    ;;
                *)
                    chroot ${iocroot}/releases/${_release}/root \
                        env UNAME_r="${_release}" env PAGER="/bin/cat" \
                        freebsd-update --not-running-from-cron fetch
                    ;;
                esac

            chroot ${iocroot}/releases/${_release}/root \
                env UNAME_r="${_release}" env PAGER="/bin/cat" \
                freebsd-update install
        fi
    fi

    if [ "${_dist}" = "1" ] ; then
        rm -rf "/usr/local/tmp/iocell-dist"
    fi

    if [ "${_ports}" = "1" ] ; then
        echo "* Updating ports for release: ${_release}."
        sleep 2

        case "${_release}" in
            9.3-RELEASE)
                # Remove the interactive check in portsnap
                sed 's/\[ ! -t 0 \]/false/' \
                    ${iocroot}/releases/${_release}/root/usr/sbin/portsnap \
                    > ${iocroot}/releases/${_release}/root/tmp/portsnap
                chmod +x ${iocroot}/releases/${_release}/root/tmp/portsnap
                chroot ${iocroot}/releases/${_release}/root \
                    env UNAME_r="${_release}" env PAGER="/bin/cat" \
                    /tmp/portsnap fetch extract
                rm ${iocroot}/releases/${_release}/root/tmp/portsnap
                ;;
            *)
                chroot ${iocroot}/releases/${_release}/root \
                    env UNAME_r="${_release}" env PAGER="/bin/cat" \
                    portsnap --interactive fetch extract
                ;;
            esac
        mkdir ${iocroot}/releases/${_release}/root/var/ports > /dev/null 2>&1
        mkdir ${iocroot}/releases/${_release}/root/var/ports/distfiles \
            > /dev/null 2>&1
        mkdir ${iocroot}/releases/${_release}/root/var/ports/packages \
            > /dev/null 2>&1
        if [ -e "${iocroot}/releases/${_release}/root/etc/make.conf" ] ; then
            _ports_string="$(fgrep -xq \
                          "## IOCAGE -- Allow a read-only /usr/ports" \
                          ${iocroot}/releases/${_release}/root/etc/make.conf \
                          ; echo $?)"
            if [ "${_ports_string}" != "0" ] ; then
                __ports_make_conf >> \
                    ${iocroot}/releases/${_release}/root/etc/make.conf
                sed -i '' s/UNAME_r=REPLACE/UNAME_r="${_release}"/ \
                    "${iocroot}/releases/${_release}/root/etc/make.conf"
            fi
        else
            __ports_make_conf > ${iocroot}/releases/${_release}/root/etc/make.conf
            sed -i '' s/UNAME_r=REPLACE/UNAME_r="${_release}"/ \
                "${iocroot}/releases/${_release}/root/etc/make.conf"
        fi
    fi

    rm -f ${iocroot}/releases/${_release}/root/etc/resolv.conf
    mkdir ${iocroot}/releases/${_release}/root/etcupdate 2> /dev/null
    chroot ${iocroot}/releases/${_release}/root \
        etcupdate build /etcupdate/etcupdate-${_release}.tbz
    umount ${iocroot}/releases/${_release}/root/dev
}

# reads tag property from given jail dataset
# Creates an alias; optional "update" also commits its source tag property.
# Returned link/write failures restore both active configs and the old alias.
__link_tag () (
    # Private subshell variables survive EXIT traps without local unwinding.
    _lt_tag="${2:-${tag:-}}"; _lt_source=''; _lt_owner=''; _lt_staging=''
    _lt_previous=''; _lt_oldmount=''; _lt_displaced=''; _lt_dated=''
    case "${_lt_tag}" in ''|.|..|*/*) __error 'invalid tag alias'; exit 1 ;; esac
    _lt_mount=$(zfs get -H -o value mountpoint "$1") || exit $?
    case "${_lt_mount}" in /*) ;; *) __error 'invalid tag mountpoint'; exit 1 ;; esac
    _lt_real=$(cd -P "${_lt_mount}" && pwd -P) || exit $?
    [ "${_lt_real}" != / ] || { __error 'invalid tag mountpoint'; exit 1; }
    _lt_altroot=$(zpool get -H -o value altroot "${pool}") || exit $?
    mkdir -p "${iocroot}/tags" || exit $?
    _lt_path="${iocroot}/tags/${_lt_tag}"; _lt_target="${_lt_mount}"
    if [ "${_lt_altroot}" != - ]; then
        case "${_lt_mount}" in
            "${iocroot}/"*) _lt_target="../${_lt_mount#"${iocroot}/"}" ;;
        esac
    fi
    if [ -L "${_lt_path}" ]; then
        _lt_previous=$(readlink "${_lt_path}") || exit $?
        case "${_lt_previous}" in /*) _lt_oldmount="${_lt_previous}" ;;
            *) _lt_oldmount="${iocroot}/tags/${_lt_previous}" ;; esac
        # A dangling alias has no live owner to retag, but is restorable on error.
        _lt_oldmount=$(cd -P "${_lt_oldmount}" 2>/dev/null && pwd -P) || _lt_oldmount=''
        if [ -n "${_lt_oldmount}" ] && [ "${_lt_oldmount}" != "${_lt_real}" ]; then
            _lt_root=$(cd -P "${iocroot}" && pwd -P) || exit $?
            case "${_lt_oldmount}" in
                "${_lt_root}/jails/"*|"${_lt_root}/templates/"*)
                    _lt_leaf="${_lt_oldmount#"${_lt_root}/"}"
                    case "${_lt_leaf#*/}" in */*) __error 'invalid old tag target'; exit 1 ;; esac ;;
                *) __error 'tag alias is outside the active jail namespace'; exit 1 ;;
            esac
            [ "$(uclcmd get -qf "${_lt_oldmount}/config" tag)" = "${_lt_tag}" ] || {
                __error 'tag alias disagrees with its target configuration'; exit 1;
            }
            _lt_displaced="${_lt_oldmount}"
        fi
    elif [ -e "${_lt_path}" ]; then
        __error "tag alias is not a symbolic link: ${_lt_path}"; exit 1
    fi
    __lt_finish () {
        trap - EXIT; trap '' HUP INT TERM
        _lt_status="$1"; _lt_failed=0
        [ -z "${_lt_staging}" ] || rm -f "${_lt_staging}/config.new"
        if [ "${_lt_status}" != 0 ]; then
            for _lt_saved in "${_lt_source}" "${_lt_owner}"; do
                [ -z "${_lt_saved}" ] ||
                    mv -f "${_lt_saved}/config.old" "${_lt_saved}/config" || _lt_failed=1
            done
            _lt_current=$(readlink "${_lt_path}") || _lt_current=''
            if [ "${_lt_failed}" = 0 ] && [ "${_lt_current}" != "${_lt_previous}" ]; then
                if [ -L "${_lt_path}" ] || [ ! -e "${_lt_path}" ]; then
                    rm -f "${_lt_path}" || _lt_failed=1
                    if [ -n "${_lt_previous}" ]; then
                        if [ -n "${_lt_dated}" ] && [ -L "${_lt_dated}" ]; then
                            mv "${_lt_dated}" "${_lt_path}" || _lt_failed=1
                        else ln -s "${_lt_previous}" "${_lt_path}" || _lt_failed=1; fi
                    fi
                else _lt_failed=1; fi
            fi
            if [ "${_lt_failed}" != 0 ]; then
                __error "tag rollback incomplete; inspect config.old and aliases: ${_lt_mount} ${_lt_displaced} ${_lt_path}"
            elif [ -n "${_lt_dated}" ] && [ -L "${_lt_dated}" ] &&
                [ "$(readlink "${_lt_dated}")" = "${_lt_previous}" ]; then
                rm -f "${_lt_dated}"
            fi
        fi
        exit "${_lt_status}"
    }
    trap '__lt_finish "$?"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if [ "${3:-}" = update ]; then
        _lt_staging="${_lt_mount}"
        __ucl_set "${_lt_mount}" tag "${_lt_tag}" prepare || exit $?
        _lt_source="${_lt_mount}"
        mv "${_lt_mount}/config.new" "${_lt_mount}/config" || exit $?
        _lt_staging=''
    fi
    if [ -n "${_lt_displaced}" ]; then
        _lt_stamp=$(date '+%F@%T'); _lt_name="${_lt_stamp}"; _lt_suffix=0
        while [ -e "${iocroot}/tags/${_lt_name}" ] || [ -L "${iocroot}/tags/${_lt_name}" ]; do
            _lt_suffix=$((_lt_suffix + 1)); _lt_name="${_lt_stamp}_${_lt_suffix}"
        done
        _lt_dated="${iocroot}/tags/${_lt_name}"
        ln -s "${_lt_previous}" "${_lt_dated}" || exit $?
        _lt_staging="${_lt_displaced}"
        __ucl_set "${_lt_displaced}" tag "${_lt_name}" prepare || exit $?
        _lt_owner="${_lt_displaced}"
        mv "${_lt_displaced}/config.new" "${_lt_displaced}/config" || exit $?
        _lt_staging=''
        __info "replacing tag ${_lt_tag}; old tag becomes ${_lt_name}"
    fi
    if [ "${_lt_oldmount}" != "${_lt_real}" ]; then
        if [ -L "${_lt_path}" ]; then ln -sfn "${_lt_target}" "${_lt_path}" || exit $?
        else ln -s "${_lt_target}" "${_lt_path}" || exit $?; fi
    fi
    exit 0
)

# Remove matching aliases; optional third argument keeps one literal tag name.
__unlink_tag () {
    local _dataset _mountpoint
    _dataset=$1

    if [ -n "${2:-}" ] ; then
        _mountpoint="$2"
    else
        _mountpoint=$(zfs get -H -o value mountpoint "${_dataset}") \
            || return $?
    fi
    [ -d "${iocroot}/tags" ] || return 0
    [ -n "${_mountpoint}" ] || return 0
    if [ -n "${3:-}" ]; then set -- "${iocroot}/tags/$3"; else set -- ''; fi
    find "${iocroot}/tags" -type l -exec sh -c '
        absolute=$1; relative=$2; keep=$3; shift 3
        for path; do
            [ "$path" != "$keep" ] || continue
            target=$(readlink "$path") || exit $?
            if [ "$target" = "$absolute" ] || [ "$target" = "$relative" ]; then
                rm -f -- "$path" || exit $?
            fi
        done
    ' sh "${_mountpoint}" "..${_mountpoint#"${iocroot}"}" "$1" {} +
}

# Log error to stderr
__error () {
    echo "  ERROR: $@" >&2
}

# Log error to stderr and exit
__die () {
    echo "  ERROR: $@" >&2
    exit 1
}

# Log info to stdout
__info () {
    echo "  INFO: $@" >&2
}

# Takes two arguments one is which text gets displayed and the other
# is the command
__spinner () (
    _sp_chars='/-\|'
    printf '%s' "$1"
    while true; do
        printf '\b%.1s' "${_sp_chars}"
        _sp_chars=${_sp_chars#?}${_sp_chars%???}
        sleep .1
    done &
    _sp_pid=$!
    trap "kill ${_sp_pid} 2>/dev/null || :; wait ${_sp_pid} 2>/dev/null || :" EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if $2; then _sp_status=0; else _sp_status=$?; fi
    if [ "${_sp_status}" = 0 ]; then printf '\b%1s\n' 'done!'
    else printf '\b%1s\n' 'failed!'; fi
    exit "${_sp_status}"
)

# The make.conf entries needed for read-only ports in a jail
__ports_make_conf () {
cat << 'EOT'

## IOCAGE -- Allow a read-only /usr/ports
UNAME_ENV+=     UNAME_s=FreeBSD
UNAME_ENV+=     UNAME_r=REPLACE
UNAME_ENV+=     UNAME_v="${UNAME_s} ${UNAME_r}"
.MAKEFLAGS:     ${UNAME_ENV}
MAKE_ENV+=      ${UNAME_ENV}
CONFIGURE_ENV+= ${UNAME_ENV}
SCRIPTS_ENV+=   ${UNAME_ENV}
WRKDIRPREFIX=   /var/ports
DISTDIR=        /var/ports/distfiles
PACKAGES=       /var/ports/packages
EOT
}

# Return the default network interface
__get_default_iface() {
    which -s dispatcherctl

    if [ $? -eq 0 ] ; then
        dispatcherctl call container.get_default_interface | jq -r .
    else
        netstat -f inet -nrW | grep '^default' | awk '{ print $6 }'
    fi
}

__pkg_wrapper () {
    local _name _command _jid _fulluuid _dataset
    shift
    _name="$1"
    shift
    _command="$*"
    _dataset="$(__find_jail ${_name})"
    _fulluuid="$(__check_name ${_name} ${_dataset})"
    _jid=$(jls -j ioc-${_fulluuid} jid 2> /dev/null)


    if [ -z "${_jid}" ]; then
        __die "${_name} is not running."
    fi

    pkg -j ${_jid} ${_command}
}

# Set a property at a jail mountpoint. Optional mode: 1 creates, prepare stages
# a normal update in config.new/config.old without publishing it.
__ucl_set () {
    local _mountpoint _property _value _create

    _mountpoint="$1"
    _property="$2"
    _value="$3"
    _create="$4"

    # A failed lookup must never turn into an edit of the host's /config.
    case "${_mountpoint}" in
        /*) ;;
        *) __error "invalid configuration mountpoint"; return 1 ;;
    esac
    if [ "${_mountpoint}" = / ] || [ ! -d "${_mountpoint}" ] ; then
        __error "invalid configuration mountpoint: ${_mountpoint}"
        return 1
    fi

    # If creating a jail this will not exist.
    if [ "${_create}" != "1" ] ; then
        uclcmd set -u -f "${_mountpoint}/config" \
            -o "${_mountpoint}/config.new" -t string -- \
            "${_property}" "${_value}" || return $?
        cp -p "${_mountpoint}/config" "${_mountpoint}/config.old" || return $?
        # Tag updates arm their rollback before publishing this prepared file.
        [ "${_create}" != prepare ] || return 0
        mv "${_mountpoint}/config.new" "${_mountpoint}/config"
    else
        uclcmd set -u -f "${_mountpoint}/config" -t string -- \
            "${_property}" "${_value}"
    fi
}
