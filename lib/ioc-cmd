#!/bin/sh

# See whether given command is readonly
# and therefore doesn't need root credentials
__readonly_cmd () {
    case "$1" in
        defaults|df|get|list|show|snaplist) echo "0"
            ;;
        *) echo "1"
            ;;
    esac
}

# Syntax-only preflight: never export properties or look up a jail here.
__cli_args_error () {
    __error "invalid arguments for $1; see iocell help"
    return 1
}

__cli_arity () {
    local _min _max _cmd
    _min="$1"; _max="$2"; _cmd="$3"
    shift 3
    [ "$#" -ge "${_min}" ] && [ "$#" -le "${_max}" ] || {
        __cli_args_error "${_cmd}"
        return 1
    }
}

__cli_targets () {
    local _arg
    [ "$#" -gt 0 ] || { __error "missing operand"; return 1; }
    for _arg in "$@" ; do
        case "${_arg}" in
            ''|-*) __error "invalid option or empty operand: ${_arg}"
                return 1 ;;
        esac
    done
}

__cli_snapshot () {
    case "$1" in
        *@*@*) ;;
        ?*@?*) return 0 ;;
    esac
    __error "expected UUID or TAG followed by @snapshot"
    return 1
}

__cli_properties () {
    local _arg _name
    for _arg in "$@" ; do
        case "${_arg}" in
            *=*) _name="${_arg%%=*}" ;;
            *) __error "expected property=value, got: ${_arg}"; return 1 ;;
        esac
        __validate_pname "${_name}" ""
    done
}

__validate_cmd () {
    local _cmd _arg _props _targets _repo _thick _opt OPTIND OPTARG
    [ "$#" -gt 0 ] || return 0
    _cmd="$1"
    shift
    case "${_cmd}" in
        help|--help|-h|version|--version|defaults|df|rcboot|rcshutdown)
            __cli_arity 0 0 "${_cmd}" "$@" || return $? ;;
        activate)
            # Keep the existing no-operand active-pool query.
            __cli_arity 0 1 "${_cmd}" "$@" || return $?
            [ "$#" -eq 0 ] || __cli_targets "$@" || return $? ;;
        cap|deactivate|export|promote|pull|push|reset|rollback|runtime|\
        snaplist|snapremove|snapumount|uncap)
            __cli_arity 1 1 "${_cmd}" "$@" || return $?
            __cli_targets "$@" || return $?
            case "${_cmd}" in
                rollback|snapremove|snapumount)
                    __cli_snapshot "$1" || return $? ;;
            esac ;;
        console|destroy|start|stop|reboot|restart)
            case "${_cmd}:${1:-}" in
                console:-f|destroy:-f|start:-f|reboot:-s|restart:-s) shift ;;
            esac
            if [ "${_cmd}" = console ] ; then
                __cli_arity 1 1 "${_cmd}" "$@" || return $?
            fi
            __cli_targets "$@" || return $? ;;
        get)
            __cli_arity 2 2 "${_cmd}" "$@" || return $?
            if [ "$1" = -r ] ; then shift; fi
            __cli_targets "$@" || return $? ;;
        inuse|limits)
            __cli_arity 0 1 "${_cmd}" "$@" || return $?
            [ "$#" -eq 0 ] || __cli_targets "$@" || return $? ;;
        init-host|snapmount)
            __cli_arity 2 2 "${_cmd}" "$@" || return $?
            __cli_targets "$@" || return $?
            if [ "${_cmd}" = snapmount ] ; then
                __cli_snapshot "$1" || return $?
            fi ;;
        list)
            case "${1:-}" in
                '') __cli_arity 0 0 "${_cmd}" "$@" || return $? ;;
                -t|-r|--warden)
                    __cli_arity 1 1 "${_cmd}" "$@" || return $? ;;
                -s)
                    __cli_arity 1 2 "${_cmd}" "$@" || return $?
                    _arg=$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')
                    case "${_arg}" in
                        ''|jid|uuid|boot|state|tag|type|ip4|release) ;;
                        *) __cli_args_error "${_cmd}"; return 1 ;;
                    esac ;;
                *) __cli_args_error "${_cmd}"; return 1 ;;
            esac ;;
        create)
            if [ "${1:-}" = -e ] ; then shift; fi
            __cli_properties "$@" || return $? ;;
        clone|import|upgrade)
            [ "$#" -gt 0 ] || { __cli_args_error "${_cmd}"; return 1; }
            __cli_targets "$1" || return $?
            if [ "${_cmd}" = clone ] ; then
                case "$1" in *=*) __cli_args_error "${_cmd}"; return 1 ;; esac
            fi
            shift
            __cli_properties "$@" || return $? ;;
        set)
            _props=0; _targets=0
            for _arg in "$@" ; do
                case "${_arg}" in
                    *=*)
                        __cli_properties "${_arg}" || return $?
                        if [ -z "${_arg#*=}" ] ; then
                            __cli_args_error "${_cmd}"
                            return 1
                        fi
                        _props=$((_props + 1)) ;;
                    *) __cli_targets "${_arg}" || return $?
                        _targets=$((_targets + 1)) ;;
                esac
            done
            if [ "${_props}" -eq 0 ] || [ "${_targets}" -eq 0 ] ; then
                __cli_args_error "${_cmd}"
                return 1
            fi ;;
        clean|exec)
            OPTIND=1; _targets=''
            if [ "${_cmd}" = clean ] ; then _props=':arjtf'
            else _props=':u:U:'; fi
            while getopts "${_props}" _opt "$@" ; do
                case "${_opt}" in
                    \?|:) __cli_args_error "${_cmd}"; return 1 ;;
                    a|r|j|t) _targets=clean ;;
                    u|U)
                        if [ -n "${_targets}" ] &&
                            [ "${_targets}" != "${_opt}" ] ; then
                            __cli_args_error "${_cmd}"
                            return 1
                        fi
                        _targets="${_opt}"
                        __cli_targets "${OPTARG}" || return $? ;;
                esac
            done
            shift $((OPTIND - 1))
            if [ "${_cmd}" = clean ] ; then
                __cli_arity 0 0 "${_cmd}" "$@" || return $?
                [ "${_targets}" = clean ] || { __cli_args_error clean; return 1; }
            else
                # Remaining arguments belong to jexec, not the iocell parser.
                __cli_targets "${1:-}" || return $?
            fi ;;
        pkg)
            [ "$#" -ge 2 ] || { __cli_args_error "${_cmd}"; return 1; }
            __cli_targets "$1" || return $?
            [ -n "$2" ] || { __cli_args_error "${_cmd}"; return 1; } ;;
        snapshot|snap)
            if [ "${1:-}" = -f ] ; then shift; fi
            if [ "${1:-}" = -r ] ; then shift; fi
            __cli_arity 1 1 "${_cmd}" "$@" || return $?
            __cli_targets "$@" || return $? ;;
        update)
            case "${1:-}" in -n|-p|-P) shift ;; esac
            __cli_arity 1 1 "${_cmd}" "$@" || return $?
            __cli_targets "$@" || return $? ;;
        fetch)
            _repo=0; _thick=0; _targets=0
            if [ "${1:-}" = -t ] ; then _thick=1; shift; fi
            for _arg in "$@" ; do
                case "${_arg}" in
                    *=*) __cli_properties "${_arg}" || return $? ;;
                    -p|-P) _targets=1 ;;
                    -*) __cli_args_error "${_cmd}"; return 1 ;;
                    */*) _repo=$((_repo + 1)) ;;
                    *) __cli_args_error "${_cmd}"; return 1 ;;
                esac
            done
            if [ "${_repo}" -gt 1 ] ||
                { [ "${_thick}" -eq 1 ] && [ "${_repo}" -ne 1 ]; } ; then
                __cli_args_error "${_cmd}"
                return 1
            fi
            if [ "${_repo}" -eq 1 ] ; then
                case "${1:-}" in
                    ''|-*|*=*) __cli_args_error "${_cmd}"; return 1 ;;
                esac
                if [ "${_targets}" -eq 1 ] ; then
                    __cli_args_error "${_cmd}"
                    return 1
                fi
            fi ;;
        send) __validate_send_args "$@" || return $? ;;
        *) __error "unknown command: ${_cmd}"; __usage >&2; return 1 ;;
    esac
    return 0
}

# Private dispatch: the entrypoint preflights before filesystem initialization.
__parse_cmd () {
    while [ $# -gt 0 ] ; do
        case "$1" in
            activate)   __activate "$2"
                        exit
                ;;
            cap)        __rctl_limits "$2"
                        exit
                ;;
            clean)      shift
                        __clean "$@"
                        exit
                ;;
            clone)      __export_props "$@"
                        __clone_jail "$2"
                        exit
                ;;
            console)    export _force=0
                        if [ "$2" = "-f" ] ; then
                            export _force=1
                            shift
                        fi
                        __console "$2"
                        exit
                ;;
            create)     local _tag _hostname _ip4if _ip4addr _ip4subnet _ip4ip
                        __load_create_defaults || exit $?
                        __export_props "$@"
                        _hostname="${host_hostname}"
                        _tag="${tag}"
                        _ip4if="$(echo ${ip4_addr} | awk 'BEGIN { FS = "|" } \
                            ; { print $1 }')"
                        _ip4addr="$(echo ${ip4_addr} | \
                            awk 'BEGIN { FS = "|" } \
                            ; { gsub("\/[0-9]+","") ; print $2 }')"
                        _ip4subnet="$(echo ${ip4_addr} | \
                            awk 'BEGIN { FS = "/" } \
                            ; { print $2 }')"

                        for _i in $(seq ${count}) ; do
                            unset uuid host_hostuuid host_hostname
                            uuid="$(uuidgen)"
                            host_hostuuid="${uuid}"

                            if [ "${count}" -eq 1 ] ; then
                                tag="${_tag}"
                                if [ -n "${iocset_host_hostname}" ] ; then
                                    host_hostname="${_hostname}"
                                else
                                    host_hostname="${uuid}"
                                fi
                            elif [ "${count}" -gt 1 ] ; then
                                tag="${_tag}_${_i}"
                                if [ -n "${iocset_host_hostname}" ] ; then
                                    host_hostname="${_hostname}_${_i}"
                                else
                                    host_hostname="${uuid}"
                                fi

                                if [ "${ip4_addr}"  != "none" ] ; then
                                    if [ "${_i}" = 1 ] ; then
                                        _ip4ip="$(echo ${_ip4addr} | \
                                            cut -d "." -f 4)"
                                    else
                                        _ip4ip="$(expr ${_ip4ip} + 1)"
                                        ip4_addr="${_ip4if}|$(echo ${_ip4addr} | \
                                            cut -d "." -f 1-3).${_ip4ip}/${_ip4subnet}"
                                    fi
                                fi
                            fi

                            __create_jail "$@" || exit $?
                        done
                        exit
                ;;
            deactivate) __deactivate "$2"
                        exit
                ;;
            defaults)   __print_defaults
                        exit
                ;;
            destroy)    export _force=0
                        shift
                        if [ "$1" = -f ] ; then
                            export _force=1
                            shift
                        fi
                        for _jdel in "$@" ; do
                            __destroy_jail "${_jdel}" || exit $?
                            unset uuid jail_zfs_dataset _fs _jail_type
                        done
                        exit
                ;;
            df)         __print_disk
                        exit
                ;;
            exec)       shift
                        __exec "$@"
                        exit
                ;;
            export)     __export "$2"
                        exit
                ;;
            fetch)      __export_props "$@"
                        local _gitcheck=$(echo $* | grep -v "ftp" | \
                                        grep -q "/" ; echo $?)

                        # Check if the user is specifying a git plugin and also
                        # check to see if they want a thick plugin
                        if [ "${_gitcheck}" = "0" ] ; then
                            shift
                            if [ "$1" = "-t" ] ; then
                                shift
                                __fetch_plugin_thick "$@"
                                exit 0
                            else
                                __fetch_plugin "$@"
                                exit 0
                            fi
                        fi

                        __fetch_release "$@"
                        exit
                ;;
            get)        __get_jail_prop "$2" "$3"
                        exit
                ;;
            help)       __help
                        exit
                ;;
            init-host)  __init_host "$2" "$3"
                        exit
                ;;
            inuse)      __rctl_inuse "$2"
                        exit
                ;;
            import)     shift
                        __import "$@"
                        exit
                ;;
            limits)     __rctl_list "$2"
                        exit
                ;;
            list)       __list_jails "$2" "$3"
                        exit
                ;;
            promote)    __promote "$2"
                        exit
                ;;
            pull)       __pull "$2"
                        exit
                ;;
            push)       __push "$2"
                        exit
                ;;
            rcboot)     __rc_jails boot
                        exit
                ;;
            rcshutdown) __rc_jails shutdown
                        exit
                ;;
            reboot|restart)    shift
                               if [ "$1" = "-s" ] ; then
                                    shift
                                    for _j in $@ ; do
                                        __restart_jail "${_j}"
                                    done
                                    exit
                               else
                                    for _j in $@ ; do
                                        __reboot_jail "${_j}"
                                    done
                                    exit
                                fi
                ;;
            reset)      __reset_jail_props "$2"
                        exit
                ;;
            rollback)   __rollback "$2"
                        exit
                ;;
            runtime)    __runtime "$2"
                        exit
                ;;
            send)       shift
                        __send "$@"
                        exit
                ;;
            set)        __export_props "$@"
                        shift
                        local _jail _fulluuid _prop _dataset
                        for _jail in "$@" ; do
                            case "${_jail}" in *=*) continue ;; esac
                            if [ "${_jail}" = default ] ; then
                                _fulluuid=default
                            else
                                _dataset=$(__find_jail "${_jail}") || exit $?
                                _fulluuid=$(__check_name "${_jail}" "${_dataset}") \
                                    || exit $?
                            fi
                            for _prop in "$@" ; do
                                case "${_prop}" in
                                    *=*) __set_jail_prop "${_prop}" \
                                        "${_fulluuid}" || exit $? ;;
                                esac
                            done
                        done
                        exit
                ;;
            snaplist)   __snaplist "$2"
                        exit
                ;;
            snapmount)  __mount_snapshot "$2" "$3"
                        exit
                ;;
            snapremove) __snapremove "$2"
                        exit
                ;;
            snapshot|snap)   if [ "$2" = "-f" ] ; then
                            export _force=1
                            shift
                        fi

                        __snapshot "$2" "$3"
                        exit
                ;;
            snapumount) __umount_snapshot "$2"
                        exit
                ;;
            start)      if [ "$2" = "-f" ] ; then
                            export _force=1
                            shift 2
                        else
                            export _force=0
                            shift
                        fi

                        for _j in $@ ; do
                            __start_jail "${_j}"
                        done
                        exit
                ;;
            stop)       shift
                        for _j in $@ ; do
                            __stop_jail "${_j}"
                        done
                        exit
                ;;
            uncap)      __rctl_uncap "$2"
                        exit
                ;;
            update)     __update "$2" "$3"
                        exit
                ;;
            upgrade)    __export_props "$@"
                        shift
                        __upgrade "$@"
                        exit
                ;;
            pkg)        __pkg_wrapper "$@"
                        exit
                ;;
            *)          __usage >&2
                        exit 1
                ;;
        esac
        shift
    done
}
