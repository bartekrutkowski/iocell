#!/bin/sh

__import_old_thickjails () {
    local _name _image _icksum _new_cksum _old_cksum _uuid _irelease _status

    _name="${1}"
    _image="${2:-$(find "${iocroot}/images/" -name "${_name}*.tar.xz")}"
    _irelease="$(printf '%s\n' "${_image##*/}" | cut -d "_" -f 2 | \
        awk 'BEGIN { FS = "." } ; { print $1"."$2 }')"
    _icksum="${_image%.tar.xz}.sha256"

    # If they don't have a release specified, we assume it's the same as host
    case "${_image##*/}" in
        *_*) ;;
        *) _irelease=$(printf '%s\n' "${release}" | \
            sed -E 's/CURRENT.*|STABLE.*/RELEASE/') ;;
    esac

    if [ -f "${_image}" ] ; then
        echo "* Found image ${_image}"
        echo "* Importing image ${_image}"

        if [ ! -f "${_icksum}" ] ; then
            echo "  ERROR: Missing checksum file!" >&2
            exit 1
        fi

        _new_cksum=$(sha256 -q "${_image}") || return $?
        _old_cksum=$(cat "${_icksum}") || return $?

        if [ "${_new_cksum}" != "${_old_cksum}" ] ; then
            echo "  ERROR: Checksum mismatch. Exiting." >&2
            exit 1
        else
            # Because any jail being imported this way are thickjails
            export type=thickjail
            _uuid=$(__create_jail "" -e) || return $?
            tar -xvJf "${_image}" -C "${iocroot}/jails/${_uuid}/root" || {
                _status=$?
                __error "archive extraction failed; partial jail retained:" \
                    "${pool}/iocell/jails/${_uuid}"
                return "${_status}"
            }
            __set_jail_prop release="${_irelease}" "${_uuid}" \
                "${pool}/iocell/jails/${_uuid}" || return $?
        fi

    else
        __die "image ${_name} not found!"
    fi

    if [ -f "${iocroot}/jails/${_uuid}/root/etc/rc.conf" ]; then
        sed -E "s/hostname.*/hostname=\"${_uuid}\"/g" \
            "${iocroot}/jails/${_uuid}/root/etc/rc.conf" \
            > "${iocroot}/jails/${_uuid}/rc.conf" || return $?
    else
        printf 'hostname="%s"\n' "${_uuid}" \
            > "${iocroot}/jails/${_uuid}/rc.conf" || return $?
    fi

    mv "${iocroot}/jails/${_uuid}/rc.conf" \
    "${iocroot}/jails/${_uuid}/root/etc/rc.conf"
}

__import () {
    local _name _fulluuid _tag _image _icount _irelease _dataset \
          _spinner _spinner_pid _status _images _candidate _image_base

    _name="${1}"

    if [ -z "${_name}" ] ; then
        __die "missing image UUID!"
    fi

    _images=$(find "${iocroot}/images/" -type f \
        ! -name '*.sha256' ! -name '*.partial') || return $?
    _image=''; _icount=0
    while IFS= read -r _candidate; do
        [ -n "${_candidate}" ] || continue
        case "${_candidate##*/}" in "${_name}"*)
            _image="${_candidate}"; _icount=$((_icount + 1)) ;;
        esac
    done <<EOF
${_images}
EOF
    [ "${_icount}" -ne 0 ] || { __error "${_name} not found!"; return 1; }
    [ "${_icount}" -eq 1 ] || {
        __error "multiple matching images, please narrow down UUID"; return 1;
    }
    # Archive routing uses the actual suffix, not a jail type substring.
    # Ordinary raw exports can also contain emptyjail/gitjail/template names.
    case "${_image}" in *.tar.xz)
        __export_props "$@"
        __import_old_thickjails "${_name}" "${_image}"
        return $? ;;
    esac
    [ "$#" -eq 1 ] || {
        __error "ordinary stream imports do not accept property operands; use set after import"
        return 1
    }
    _image_base="${_image##*/}"
    case "${_image_base}" in
        *_*) _irelease="${_image_base##*_}" ;;
        *) _irelease="${release}" ;;
    esac

    if [ -e "${iocroot}/jails/${_name}" ] ; then
        _dataset=$(__find_jail "${_name}") || return $?
        _fulluuid=$(__check_name "${_name}" "${_dataset}") || return $?
        _tag=$(__get_jail_prop tag "${_fulluuid}" "${_dataset}") || return $?
        __die "${_name} has already been imported (${_tag})"
    elif [ ! -e "${iocroot}/releases/${_irelease}" ] ; then
        __die "please fetch ${_irelease} first."
    else
        # __spinner needs to be recreated here as we redirect with zfs send
        _spinner='/-\|'

        printf "  INFO: importing ${_name}:  "

        while true; do
            printf '\b%.1s' "${_spinner}"
            _spinner=${_spinner#?}${_spinner%???}
            sleep .1
        done &

        _spinner_pid=$!
        trap 'kill "${_spinner_pid}" 2>/dev/null' 2 3
        _status=0
        zfs recv -d "${pool}" < "${_image}" || _status=$?
        kill "${_spinner_pid}" 2>/dev/null || :
        wait "${_spinner_pid}" 2>/dev/null || :
        trap - 2 3

        if [ "${_status}" -ne 0 ] ; then
            __error "import failed; image retained. Inspect any partially" \
                "received datasets before retrying."
            return "${_status}"
        fi

        printf "\b%1s\n" "done!"
        return 0
    fi
}

__export () (
    umask 077
    _ex_name="$1"
    [ -n "${_ex_name}" ] || { __error "missing UUID or TAG!"; exit 1; }
    _ex_ds=$(__find_jail "${_ex_name}") || exit $?
    _ex_uuid=$(__check_name "${_ex_name}" "${_ex_ds}") || exit $?
    _ex_state=$(jls -j "ioc-${_ex_uuid}" jid 2>/dev/null) || {
        _ex_status=$?
        [ "${_ex_status}" -eq 1 ] || exit "${_ex_status}"
        _ex_state=
    }
    [ -z "${_ex_state}" ] || { __error "stop the jail before exporting"; exit 1; }
    _ex_type=$(__get_jail_prop type "${_ex_uuid}" "${_ex_ds}") || exit $?
    _ex_release=$(__get_jail_prop release "${_ex_uuid}" "${_ex_ds}") || exit $?
    _ex_migrate=0
    if [ "${_ex_type}" = jail ]; then
        _ex_origin=$(zfs get -H -o value origin "${_ex_ds}") || exit $?
        if [ "${_ex_origin}" = - ]; then _ex_type=thickjail
        else _ex_type=clonejail; fi
        _ex_migrate=1
    fi
    for _ex_part in "${_ex_uuid}" "${_ex_type}" "${_ex_release}"; do
        case "${_ex_part}" in ''|*[![:alnum:]_.:-]*)
            __error "unsafe image name component: ${_ex_part}"; exit 1 ;;
        esac
    done
    _ex_date=$(date +%F)
    _ex_image="${iocroot}/images/${_ex_uuid}-${_ex_type}-${_ex_date}_${_ex_release}"
    _ex_partial="${_ex_image}.partial"
    if [ -e "${_ex_image}" ] || [ -L "${_ex_image}" ] ||
        [ -e "${_ex_partial}" ] || [ -L "${_ex_partial}" ]; then
        __error "existing image/partial image retained: ${_ex_image}"
        exit 1
    fi
    if [ "${_ex_migrate}" = 1 ]; then
        __set_jail_prop "type=${_ex_type}" "${_ex_uuid}" "${_ex_ds}" || exit $?
    fi
    mkdir -p "${iocroot}/images" || exit $?
    _ex_snap="${_ex_ds}@ioc-export-${_ex_date}"
    zfs snapshot -r "${_ex_snap}" || exit $?
    printf '  INFO: exporting %s: ' "${_ex_uuid}"
    if ( set -C; zfs send -R "${_ex_snap}" > "${_ex_partial}" ); then :
    else
        _ex_status=$?
        __error "export failed; partial image and snapshot retained: ${_ex_partial} ${_ex_snap}"
        exit "${_ex_status}"
    fi
    # Hard-link publication refuses an existing final name without overwriting.
    ln "${_ex_partial}" "${_ex_image}" || exit $?
    rm "${_ex_partial}" || exit $?
    zfs destroy -r "${_ex_snap}" || {
        _ex_status=$?
        __error "image complete; export snapshot cleanup failed: ${_ex_snap}"
        exit "${_ex_status}"
    }
    echo 'done!'
)
