    Default: off
    Source: rctl(8)

.fam T
.fi
pcpu=limit:action | off
.PP
.nf
.fam C
    Limit %CPU, in percents of a single CPU core or hardware thread.

    Default: off
    Source: rctl(8)

.fam T
.fi
datasize=limit:action | off
.PP
.nf
.fam C
    Limit data size.

    Default: off
    Source: rctl(8)

.fam T
.fi
stacksize=limit:action | off
.PP
.nf
.fam C
    Limit stack size.

    Default: off
    Source: rctl(8)

.fam T
.fi
coredumpsize=limit:action | off
